{
  "__inputs": [],
  "uid": "hetzner-costs",
  "title": "Hetzner Cloud Costs",
  "tags": [
    "hetzner",
    "costs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(hetzner_cloud_exporter_build_info, job)",
          "refId": "var"
        },
        "definition": "label_values(hetzner_cloud_exporter_build_info, job)",
        "refresh": 2,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Monthly cost (net)",
      "description": "Net (without VAT), in the account's currency. Estimate from Hetzner's prices, not an invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (__name__, server, load_balancer, volume, floating_ip, primary_ip, image_id, storage_box) ({job=\"$job\", __name__=~\"hetzner_cloud_.+_monthly_price\"}))",
          "legendFormat": "",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Unused resources (net/month)",
      "description": "Unassigned IPs and unattached volumes per month. Net (without VAT), in the account's currency. Estimate from Hetzner's prices, not an invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(max by (primary_ip) (hetzner_cloud_primary_ip_monthly_price{job=\"$job\"}) and on (primary_ip) (max by (primary_ip) (hetzner_cloud_primary_ip_assigned{job=\"$job\"}) == 0)) or vector(0)) + (sum(max by (floating_ip) (hetzner_cloud_floating_ip_monthly_price{job=\"$job\"}) and on (floating_ip) (max by (floating_ip) (hetzner_cloud_floating_ip_assigned{job=\"$job\"}) == 0)) or vector(0)) + (sum(max by (volume) (hetzner_cloud_volume_monthly_price{job=\"$job\"}) and on (volume) (max by (volume) (hetzner_cloud_volume_attached{job=\"$job\"}) == 0)) or vector(0))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Snapshots (net/month)",
      "description": "Snapshots per month. Net (without VAT), in the account's currency. Estimate from Hetzner's prices, not an invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (image_id) (hetzner_cloud_image_monthly_price{job=\"$job\"}))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Traffic overage (servers, net)",
      "description": "Expected cost of outbound traffic above the included amount in this billing period. Net (without VAT), in the account's currency. Estimate from Hetzner's prices, not an invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(clamp_min(max by (server) (hetzner_cloud_server_outgoing_traffic_bytes{job=\"$job\"}) - max by (server) (hetzner_cloud_server_included_traffic_bytes{job=\"$job\"} > 0), 0) / 1099511627776 * on (server) max by (server) (hetzner_cloud_server_traffic_price_per_tb{job=\"$job\"})) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "piechart",
      "title": "Cost by kind of resource (net/month)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(sum by (__name__) (max by (__name__, server, load_balancer, volume, floating_ip, primary_ip, image_id, storage_box) ({job=\"$job\", __name__=~\"hetzner_cloud_.+_monthly_price\"})), \"kind\", \"$1\", \"__name__\", \"hetzner_cloud_(.+)_monthly_price\")",
          "legendFormat": "{{kind}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Monthly cost over time (net)",
      "description": "Net (without VAT), in the account's currency. Estimate from Hetzner's prices, not an invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (__name__, server, load_balancer, volume, floating_ip, primary_ip, image_id, storage_box) ({job=\"$job\", __name__=~\"hetzner_cloud_.+_monthly_price\"}))",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 10,
        "y": 5,
        "w": 14,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Most expensive resources",
      "description": "Net (without VAT), in the account's currency. Estimate from Hetzner's prices, not an invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(topk(20, label_join(label_replace(label_join(max by (__name__, server, load_balancer, volume, floating_ip, primary_ip, image, image_id, storage_box) ({job=\"$job\", __name__=~\"hetzner_cloud_.+_monthly_price\"}), \"snapshot\", \" #\", \"image\", \"image_id\"), \"snapshot\", \"\", \"snapshot\", \" #\"), \"resource\", \"\", \"server\", \"load_balancer\", \"volume\", \"floating_ip\", \"primary_ip\", \"snapshot\", \"storage_box\")), \"kind\", \"$1\", \"__name__\", \"hetzner_cloud_(.+)_monthly_price\")",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "kind": 0,
              "resource": 1,
              "Value": 2
            },
            "renameByName": {
              "kind": "Kind",
              "resource": "Resource",
              "Value": "Per month (net)"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Kind",
                "Resource",
                "Per month (net)"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Per month (net)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Per month (net)",
            "desc": true
          }
        ]
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Unused resources that cost money",
      "description": "Unassigned IPs and unattached volumes. Net (without VAT), in the account's currency. Estimate from Hetzner's prices, not an invoice.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(max by (primary_ip) (hetzner_cloud_primary_ip_monthly_price{job=\"$job\"}) and on (primary_ip) (max by (primary_ip) (hetzner_cloud_primary_ip_assigned{job=\"$job\"}) == 0), \"resource\", \"primary IP $1\", \"primary_ip\", \"(.*)\") or label_replace(max by (floating_ip) (hetzner_cloud_floating_ip_monthly_price{job=\"$job\"}) and on (floating_ip) (max by (floating_ip) (hetzner_cloud_floating_ip_assigned{job=\"$job\"}) == 0), \"resource\", \"floating IP $1\", \"floating_ip\", \"(.*)\") or label_replace(max by (volume) (hetzner_cloud_volume_monthly_price{job=\"$job\"}) and on (volume) (max by (volume) (hetzner_cloud_volume_attached{job=\"$job\"}) == 0), \"resource\", \"volume $1\", \"volume\", \"(.*)\")",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "resource": 0,
              "Value": 1
            },
            "renameByName": {
              "resource": "Resource",
              "Value": "Per month (net)"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Resource",
                "Per month (net)"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Per month (net)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 10
      }
    }
  ]
}
