{
  "__inputs": [],
  "uid": "hetzner-inventory",
  "title": "Hetzner Cloud Inventory",
  "tags": [
    "hetzner",
    "inventory"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(hetzner_cloud_exporter_build_info, job)",
          "refId": "var"
        },
        "definition": "label_values(hetzner_cloud_exporter_build_info, job)",
        "refresh": 2,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Servers",
      "description": "Last backup: newest backup from the images collector (every 10m); empty if the server has none.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server, server_type, location, status) (hetzner_cloud_server_info{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (hetzner_cloud_server_cpu_cores{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (hetzner_cloud_server_memory_bytes{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (hetzner_cloud_server_monthly_price{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (hetzner_cloud_server_backup_enabled{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (hetzner_cloud_server_delete_protection{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (hetzner_cloud_server_type_deprecated{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) ((time() - hetzner_cloud_server_last_backup_timestamp_seconds{job=\"$job\"}) / 86400)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "server": 0,
              "server_type": 1,
              "location": 2,
              "status": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #F": 8,
              "Value #G": 9,
              "Value #H": 10
            },
            "renameByName": {
              "server": "Server",
              "server_type": "Type",
              "location": "Location",
              "status": "Status",
              "Value #B": "vCPUs",
              "Value #C": "Memory",
              "Value #D": "Price/month (net)",
              "Value #E": "Backups",
              "Value #F": "Delete protection",
              "Value #G": "Type deprecated",
              "Value #H": "Last backup (days ago)"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Server",
                "Type",
                "Location",
                "Status",
                "vCPUs",
                "Memory",
                "Price/month (net)",
                "Backups",
                "Delete protection",
                "Type deprecated",
                "Last backup (days ago)"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Price/month (net)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Backups"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "On",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "Off",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Delete protection"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "On",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "Off",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Type deprecated"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Yes",
                        "color": "orange",
                        "index": 0
                      },
                      "0": {
                        "text": "No",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last backup (days ago)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 2,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Certificates",
      "description": "Managed certificates renew automatically; failed or unavailable renewal needs attention.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (certificate, certificate_type) ((hetzner_cloud_certificate_not_valid_after_timestamp_seconds{job=\"$job\"} - time()) / 86400)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (certificate, issuance) (label_replace(hetzner_cloud_certificate_status{job=\"$job\", process=\"issuance\"}, \"issuance\", \"$1\", \"status\", \"(.*)\"))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (certificate, renewal) (label_replace(hetzner_cloud_certificate_status{job=\"$job\", process=\"renewal\"}, \"renewal\", \"$1\", \"status\", \"(.*)\"))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "certificate": 0,
              "certificate_type": 1,
              "Value #A": 2,
              "issuance": 3,
              "renewal": 4
            },
            "renameByName": {
              "certificate": "Certificate",
              "certificate_type": "Type",
              "Value #A": "Days left",
              "issuance": "Issuance",
              "renewal": "Renewal"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Certificate",
                "Type",
                "Days left",
                "Issuance",
                "Renewal"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Days left"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 3,
                      "color": "orange"
                    },
                    {
                      "value": 14,
                      "color": "green"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Days left",
            "desc": false
          }
        ]
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Storage Boxes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (storage_box) (hetzner_cloud_storage_box_used_bytes{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (storage_box) (hetzner_cloud_storage_box_quota_bytes{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max by (storage_box) (hetzner_cloud_storage_box_used_bytes{job=\"$job\"}) / max by (storage_box) (hetzner_cloud_storage_box_quota_bytes{job=\"$job\"} > 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "storage_box": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "storage_box": "Storage Box",
              "Value #A": "Used",
              "Value #B": "Quota",
              "Value #C": "Used %"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Storage Box",
                "Used",
                "Quota",
                "Used %"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quota"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 80,
                      "color": "orange"
                    },
                    {
                      "value": 95,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Volumes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(max by (volume, location, server_id) (hetzner_cloud_volume_info{job=\"$job\"}) * on (server_id) group_left (server) max by (server_id, server) (hetzner_cloud_server_info{job=\"$job\"})) or (max by (volume, location, server_id) (hetzner_cloud_volume_info{job=\"$job\"}) unless on (volume) (max by (volume, location, server_id) (hetzner_cloud_volume_info{job=\"$job\"}) * on (server_id) group_left (server) max by (server_id, server) (hetzner_cloud_server_info{job=\"$job\"})))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (volume) (hetzner_cloud_volume_size_bytes{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (volume) (hetzner_cloud_volume_attached{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (volume) (hetzner_cloud_volume_monthly_price{job=\"$job\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "volume": 0,
              "location": 1,
              "server": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "volume": "Volume",
              "location": "Location",
              "server": "Server",
              "Value #B": "Size",
              "Value #C": "Attached",
              "Value #D": "Price/month (net)"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Volume",
                "Location",
                "Server",
                "Size",
                "Attached",
                "Price/month (net)"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Price/month (net)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attached"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Yes",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "No (costs money)",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "IP addresses",
      "description": "Primary and floating IPs with the server they are assigned to. Unassigned IPv4 addresses cost money.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(label_replace(((label_replace(max by (primary_ip, ip, primary_ip_type, location, server_id) (hetzner_cloud_primary_ip_info{job=\"$job\"}), \"type\", \"$1\", \"primary_ip_type\", \"(.*)\") * on (server_id) group_left (server) max by (server_id, server) (hetzner_cloud_server_info{job=\"$job\"})) or (label_replace(max by (primary_ip, ip, primary_ip_type, location, server_id) (hetzner_cloud_primary_ip_info{job=\"$job\"}), \"type\", \"$1\", \"primary_ip_type\", \"(.*)\") unless on (primary_ip) (label_replace(max by (primary_ip, ip, primary_ip_type, location, server_id) (hetzner_cloud_primary_ip_info{job=\"$job\"}), \"type\", \"$1\", \"primary_ip_type\", \"(.*)\") * on (server_id) group_left (server) max by (server_id, server) (hetzner_cloud_server_info{job=\"$job\"})))) * on (primary_ip) group_left max by (primary_ip) (hetzner_cloud_primary_ip_assigned{job=\"$job\"}), \"name\", \"$1\", \"primary_ip\", \"(.*)\"), \"kind\", \"primary\", \"\", \"\") or label_replace(label_replace(((label_replace(max by (floating_ip, ip, floating_ip_type, location, server_id) (hetzner_cloud_floating_ip_info{job=\"$job\"}), \"type\", \"$1\", \"floating_ip_type\", \"(.*)\") * on (server_id) group_left (server) max by (server_id, server) (hetzner_cloud_server_info{job=\"$job\"})) or (label_replace(max by (floating_ip, ip, floating_ip_type, location, server_id) (hetzner_cloud_floating_ip_info{job=\"$job\"}), \"type\", \"$1\", \"floating_ip_type\", \"(.*)\") unless on (floating_ip) (label_replace(max by (floating_ip, ip, floating_ip_type, location, server_id) (hetzner_cloud_floating_ip_info{job=\"$job\"}), \"type\", \"$1\", \"floating_ip_type\", \"(.*)\") * on (server_id) group_left (server) max by (server_id, server) (hetzner_cloud_server_info{job=\"$job\"})))) * on (floating_ip) group_left max by (floating_ip) (hetzner_cloud_floating_ip_assigned{job=\"$job\"}), \"name\", \"$1\", \"floating_ip\", \"(.*)\"), \"kind\", \"floating\", \"\", \"\")",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "ip": 0,
              "server": 1,
              "type": 2,
              "kind": 3,
              "location": 4,
              "Value": 5,
              "name": 6
            },
            "renameByName": {
              "ip": "IP",
              "server": "Server",
              "type": "Type",
              "kind": "Kind",
              "location": "Location",
              "Value": "Assigned",
              "name": "Name"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "IP",
                "Server",
                "Type",
                "Kind",
                "Location",
