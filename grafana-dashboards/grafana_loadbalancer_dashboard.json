{
  "__inputs": [],
  "uid": "hetzner-lb-dashboard",
  "title": "Hetzner Cloud Load Balancers",
  "tags": [
    "hetzner",
    "load_balancer"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(hetzner_cloud_exporter_build_info, job)",
          "refId": "var"
        },
        "definition": "label_values(hetzner_cloud_exporter_build_info, job)",
        "refresh": 2,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "sort": 1
      },
      {
        "name": "load_balancer",
        "label": "Load Balancer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(hetzner_cloud_load_balancer_info{job=\"$job\"}, load_balancer)",
          "refId": "var"
        },
        "definition": "label_values(hetzner_cloud_load_balancer_info{job=\"$job\"}, load_balancer)",
        "refresh": 2,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "$load_balancer",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "gauge",
      "title": "Connections",
      "description": "Open connections in % of the Load Balancer type's maximum (needs --hcloud.metrics-interval > 0)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max(hetzner_cloud_load_balancer_open_connections{job=\"$job\", load_balancer=\"$load_balancer\"}) / max(hetzner_cloud_load_balancer_max_connections{job=\"$job\", load_balancer=\"$load_balancer\"} > 0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "gauge",
      "title": "Targets",
      "description": "Targets in % of the type's maximum (label selectors expanded)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max(hetzner_cloud_load_balancer_targets{job=\"$job\", load_balancer=\"$load_balancer\"}) / max(hetzner_cloud_load_balancer_max_targets{job=\"$job\", load_balancer=\"$load_balancer\"} > 0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "gauge",
      "title": "Services",
      "description": "Services in % of the type's maximum",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max(hetzner_cloud_load_balancer_services{job=\"$job\", load_balancer=\"$load_balancer\"}) / max(hetzner_cloud_load_balancer_max_services{job=\"$job\", load_balancer=\"$load_balancer\"} > 0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "gauge",
      "title": "Certificates",
      "description": "Assigned certificates in % of the type's maximum",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max(hetzner_cloud_load_balancer_certificates{job=\"$job\", load_balancer=\"$load_balancer\"}) / max(hetzner_cloud_load_balancer_max_certificates{job=\"$job\", load_balancer=\"$load_balancer\"} > 0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "gauge",
      "title": "Traffic",
      "description": "Outbound traffic in % of the included traffic in this billing period; more is billed. \"Not reported\": the API returns 0 included traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max(hetzner_cloud_load_balancer_outgoing_traffic_bytes{job=\"$job\", load_balancer=\"$load_balancer\"}) / max(hetzner_cloud_load_balancer_included_traffic_bytes{job=\"$job\", load_balancer=\"$load_balancer\"} > 0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "orange"
              },
              {
                "value": 95,
                "color": "red"
              }
            ]
          },
          "noValue": "Not reported"
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Unhealthy targets",
      "description": "Targets unhealthy for at least one service (unknown is not counted)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (load_balancer, target_type, server, server_id, ip) (hetzner_cloud_load_balancer_target_unhealthy_services{job=\"$job\", load_balancer=\"$load_balancer\", target_type!=\"\"}) > 0) or (0 * count(hetzner_cloud_load_balancer_target_unhealthy_services{job=\"$job\", load_balancer=\"$load_balancer\"}))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Type",
      "description": "Load Balancer type",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer_type) (hetzner_cloud_load_balancer_info{job=\"$job\", load_balancer=\"$load_balancer\"})",
          "legendFormat": "{{load_balancer_type}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 8,
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 3
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Details",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer) (hetzner_cloud_load_balancer_requests_per_second{job=\"$job\", load_balancer=\"$load_balancer\"})",
          "legendFormat": "requests/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Bandwidth",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer) (hetzner_cloud_load_balancer_bandwidth_bytes_per_second{job=\"$job\", load_balancer=\"$load_balancer\", direction=\"in\"}) * 8",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer) (hetzner_cloud_load_balancer_bandwidth_bytes_per_second{job=\"$job\", load_balancer=\"$load_balancer\", direction=\"out\"}) * 8",
          "legendFormat": "out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Connections per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer) (hetzner_cloud_load_balancer_connections_per_second{job=\"$job\", load_balancer=\"$load_balancer\"})",
          "legendFormat": "connections/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Open connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer) (hetzner_cloud_load_balancer_open_connections{job=\"$job\", load_balancer=\"$load_balancer\"})",
          "legendFormat": "open"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer) (hetzner_cloud_load_balancer_max_connections{job=\"$job\", load_balancer=\"$load_balancer\"})",
          "legendFormat": "limit of the type"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "state-timeline",
      "title": "Target health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Per target and service port. Unknown: e.g. right after a target was added.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer, target_type, server, server_id, ip, listen_port) (2 * hetzner_cloud_load_balancer_target_health_status{job=\"$job\", load_balancer=\"$load_balancer\", status=\"healthy\"} or 1 * hetzner_cloud_load_balancer_target_health_status{job=\"$job\", load_balancer=\"$load_balancer\", status=\"unknown\"} or 0 * hetzner_cloud_load_balancer_target_health_status{job=\"$job\", load_balancer=\"$load_balancer\", status=\"unhealthy\"})",
          "legendFormat": "{{server}} {{ip}} port {{listen_port}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "#808080"
              },
              {
                "value": 2,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unhealthy",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Unknown",
                  "color": "#808080",
                  "index": 1
                },
                "2": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Targets not healthy (with reason)",
      "description": "detail: layer4_* = network/firewall/host, layer7_*/unexpected_http_* = application",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (load_balancer, target_type, server, server_id, ip, listen_port, status, detail, http_status_code) (hetzner_cloud_load_balancer_target_health_status{job=\"$job\", load_balancer=\"$load_balancer\", status!=\"healthy\"}) or on () (label_replace(vector(1), \"status\", \"✓ All targets are healthy\", \"\", \"\") and on () count(hetzner_cloud_load_balancer_target_health_status{job=\"$job\", load_balancer=\"$load_balancer\"}) > 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "server": 0,
              "server_id": 1,
              "ip": 2,
              "listen_port": 3,
              "status": 4,
              "detail": 5,
              "http_status_code": 6
            },
            "renameByName": {
              "server": "Server",
              "server_id": "Server ID",
              "ip": "IP",
              "listen_port": "Port",
              "status": "Status",
              "detail": "Reason",
              "http_status_code": "HTTP status"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Server",
                "Server ID",
                "IP",
                "Port",
                "Status",
                "Reason",
                "HTTP status"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Connection usage (% of the type's limit)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
