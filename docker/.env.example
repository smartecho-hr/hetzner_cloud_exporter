# Copy to docker/.env and fill in. Only HCLOUD_API_TOKEN is required.
# A read-only Hetzner Cloud API token is enough.
# Keep comments on their own lines: `docker run --env-file` doesn't strip
# comments after a value.
HCLOUD_API_TOKEN=your-hcloud-api-token

# Or a mounted secret file instead of the token:
#HCLOUD_API_TOKEN_FILE=/run/secrets/hcloud_token

# Optional, defaults shown.
#LISTEN_ADDRESS=:9210
#METRICS_PATH=/metrics
#POLL_INTERVAL=60s
# Server and Load Balancer metrics, 0 = off:
#METRICS_INTERVAL=60s
#CONCURRENCY=5
#LOG_LEVEL=info
# Config file; when set, the file must exist (mount it):
#CONFIG_FILE=/app/config.yaml
# TLS / basic auth; mount the file:
#WEB_CONFIG_FILE=/app/web.yml
# Turn off collectors you don't need:
#COLLECTOR_SSH_KEYS=false
# How often a collector is fetched, 0 = every poll:
#COLLECTOR_IMAGES_INTERVAL=10m
